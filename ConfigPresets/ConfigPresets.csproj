<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="..\libs\**" />
    <EmbeddedResource Remove="..\libs\**" />
    <None Remove="..\libs\**" />
    <!-- a project of its own -->
    <Compile Remove="Patcher\**" />
    <EmbeddedResource Remove="Patcher\**" />
    <None Remove="Patcher\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="InLobbyConfig">
      <HintPath>..\libs\InLobbyConfig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RiskOfOptions">
      <HintPath>..\libs\RiskOfOptions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the preloader patcher, which goes into the patchers folder -->
    <ProjectReference Include="Patcher\ConfigPresets.Patcher.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPatcher" BeforeTargets="PostBuildEvent">
    <ItemGroup>
      <PatcherAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'ConfigPresets.Patcher'" />
    </ItemGroup>
    <Copy SourceFiles="@(PatcherAssembly)" DestinationFolder="$(TargetDir)patchers" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
