<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- a preloader patcher, so that it starts before the plugins -->
    <BepInExFolder>patchers</BepInExFolder>
    <!-- BepInEx runs the patchers in the order of their assembly names, so this one comes first, before MonoDetour's
         0.com.github.MonoDetour.BepInEx.5 -->
    <AssemblyName>0.0.Def.StartupProfiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="..\libs\**" />
    <EmbeddedResource Remove="..\libs\**" />
    <None Remove="..\libs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
